{
	"compilerOptions": {
		"strict": true,
		"skipLibCheck": true,
		"noEmit": true,
		"target": "es2023",
		"module": "esnext",
		"moduleResolution": "bundler",
		"lib": ["es2023", "dom", "dom.iterable"],
		"types": ["node"],
		"erasableSyntaxOnly": true,
		"verbatimModuleSyntax": true,
		"isolatedModules": true,
		"allowImportingTsExtensions": true
	},
	"include": ["src/**/*.ts", "test/**/*.ts"],
	"exclude": ["src/sw.ts"]
}
