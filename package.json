{
	"name": "psychodynamometer",
	"version": "1.0.0",
	"description": "Static, shareable progress visualiser for time-bounded therapy and coaching groups",
	"type": "module",
	"private": true,
	"engines": {
		"node": ">=26"
	},
	"browserslist": [
		"baseline widely available"
	],
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"preview": "vite preview",
		"test": "vitest run",
		"test:e2e": "vite build && node e2e/e2e.ts",
		"typecheck": "tsc",
		"lint:js": "eslint .",
		"lint:css": "stylelint \"**/*.css\"",
		"lint:html": "markuplint \"**/*.html\"",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"check": "npm run typecheck && npm run lint:html && npm run lint:css && npm run lint:js && npm run format:check && npm test && npm run build"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.1",
		"@commitlint/config-conventional": "^21.2.0",
		"@eslint/js": "^10.0.1",
		"@types/node": "^26.1.1",
		"browserslist": "^4.28.7",
		"eslint": "^10.7.0",
		"globals": "^17.7.0",
		"lightningcss": "^1.33.0",
		"markuplint": "^4.18.3",
		"playwright": "^1.61.1",
		"prettier": "^3.9.6",
		"stylelint": "^17.14.1",
		"stylelint-config-pepelsbey": "^1.5.0",
		"stylelint-config-standard": "^40.0.0",
		"stylelint-order": "^8.1.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.65.0",
		"vite": "^8.1.5",
		"vitest": "^4.1.10"
	}
}
