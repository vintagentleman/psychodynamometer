{
	"name": "psycho-group-progress",
	"version": "1.0.0",
	"description": "Static, shareable progress visualiser for time-bounded therapy and coaching groups",
	"type": "module",
	"private": true,
	"engines": {
		"node": ">=26"
	},
	"scripts": {
		"test": "node --test",
		"test:e2e": "node e2e/e2e.mjs",
		"typecheck": "tsc",
		"lint": "eslint .",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"check": "npm run typecheck && npm run lint && npm run format:check && npm test"
	},
	"devDependencies": {
		"@commitlint/cli": "^21.2.1",
		"@commitlint/config-conventional": "^21.2.0",
		"@eslint/js": "^10.0.1",
		"@types/node": "^26.1.1",
		"eslint": "^10.7.0",
		"globals": "^17.7.0",
		"playwright": "^1.61.1",
		"prettier": "^3.9.6",
		"typescript": "^7.0.2"
	}
}
